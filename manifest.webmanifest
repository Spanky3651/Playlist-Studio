{
  "id": "./",
  "name": "Playlist Studio",
  "short_name": "Playlist Studio",
  "description": "Build Beat Saber playlists from BeatLeader and BeatSaver, with your scores, PP and Studio Sync to your Quest.",
  "start_url": "./?utm_source=pwa&utm_campaign=installed",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "background_color": "#05070c",
  "theme_color": "#05070c",
  "categories": ["games", "music", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./?utm_source=pwa&utm_campaign=open-file",
      "accept": { "application/x-beat-saber-playlist": [".bplist"] },
      "icons": [
        { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "launch_type": "single-client"
    }
  ]
}
